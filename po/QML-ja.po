msgctxt "BayesianSSMforAS|"
msgid "Include the baseline innovation scale %1 in the overview table."
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid ""
"Include the prediction for the total defects in the current lot in the "
"overview table."
msgstr ""

