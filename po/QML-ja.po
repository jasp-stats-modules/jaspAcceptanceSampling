msgid "Thinning"
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid "Thinning interval."
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid ""
"With Thinning greater than 1, divergence and treedepth counts cover only "
"retained transitions; events in omitted iterations cannot be counted. E-BFMI "
"is unavailable because saved energies are not consecutive. Use Thinning = 1 "
"for complete sampler checks."
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid "Random seed."
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid "Adapt delta"
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid ""
"Target acceptance probability for HMC adaptation (default 0.97). A higher "
"value generally produces smaller integration steps and may help resolve "
"divergences, at the cost of longer computation."
msgstr ""

msgctxt "BayesianSSMforAS|"
msgid ""
"Limit on the depth of HMC's trajectory construction (default 15). Reaching "
"this limit can reduce sampling efficiency; increasing it permits longer "
"trajectories and can increase computation time."
msgstr ""

